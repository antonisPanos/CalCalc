rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every document lives under the owning user's uid, and only that user may touch it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
