<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower (minSdk is 35, so these are kept only for
   completeness; data_extraction_rules.xml is what applies).

   The settings DataStore holds the Gemini API key, encrypted with an Android Keystore key.
   Keystore keys never leave the device, so a backed-up copy could never be decrypted.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/settings.preferences_pb" />
</full-backup-content>
