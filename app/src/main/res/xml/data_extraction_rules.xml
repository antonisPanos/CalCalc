<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12+.

   The settings DataStore holds the Gemini API key, encrypted with an Android Keystore key.
   Keystore keys never leave the device, so a restored copy could never be decrypted; the
   key is re-entered in Profile on a new phone instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
