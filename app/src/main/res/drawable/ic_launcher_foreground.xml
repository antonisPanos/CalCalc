<?xml version="1.0" encoding="utf-8"?>
<!--
  A calorie gauge that is also a clock: the 270° arc is the app's progress ring, the hands
  are the fasting timer. Everything sits inside the 66dp adaptive safe zone (the art spans
  25..83 on the 108 canvas), so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Track: the unfilled remainder of the ring. Two arcs, because a single arc command
         cannot close a full circle. -->
    <path
        android:pathData="M54,29 A25,25 0 1 1 54,79 A25,25 0 1 1 54,29"
        android:strokeColor="#26332B"
        android:strokeWidth="8" />

    <!-- Progress: 270° clockwise from twelve o'clock. -->
    <path
        android:pathData="M54,29 A25,25 0 1 1 29,54"
        android:strokeColor="#7CD992"
        android:strokeWidth="8"
        android:strokeLineCap="round" />

    <path
        android:pathData="M54,54 L54,39"
        android:strokeColor="#E6EAE7"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,54 L65.2,60"
        android:strokeColor="#E6EAE7"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />

    <path
        android:pathData="M54,50.8 A3.2,3.2 0 1 1 54,57.2 A3.2,3.2 0 1 1 54,50.8"
        android:fillColor="#7CD992" />
</vector>
